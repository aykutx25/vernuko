<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Company>Vernuko</Company>
    <Product>Vernuko</Product>
    <Copyright>© 2026 Vernuko</Copyright>
    <Version>0.10.0</Version>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <!-- WPF projects can be compiled (not run) on Linux/macOS CI with this flag. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Supply-chain: fail restore on known-vulnerable packages. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- CA1515 (make types internal) is noisy for a modular monolith with public module contracts. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1716;CA1711;CA1724;CA1307;CA1309;CA1310;CA1305;CA1304;CA1311;CA2007;CA1031;CA1062;CA1303;CA1812;CA1819;CA1002;CA1034;CA1056;CA1054;CA1055;CA2227;CA1861;CA1308;CA5394;CA1822;CA1859;CA1826;CA1851;CA1863;CA1873</NoWarn>
  </PropertyGroup>
</Project>
