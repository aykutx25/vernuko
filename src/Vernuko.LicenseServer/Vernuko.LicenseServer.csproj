<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Vernuko.LicenseServer</RootNamespace>
    <!-- Runs on a small Linux VPS; never ships with the desktop app. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vernuko.Core\Vernuko.Core.csproj" />
    <ProjectReference Include="..\Vernuko.Licensing\Vernuko.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vernuko.Tests" />
  </ItemGroup>
</Project>
