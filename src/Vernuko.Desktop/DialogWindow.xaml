<Window x:Class="Vernuko.Desktop.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vernuko" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource AppFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Subtle}" Foreground="{StaticResource TextBrush}" LineHeight="20" />
        <TextBox x:Name="Input" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="96" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="OkButton" IsDefault="True" MinWidth="96" Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
