<Window x:Class="Vernuko.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vernuko" Width="1440" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="Assets/vernuko.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <ContentControl Content="{Binding Screen}" Focusable="False" />

        <!-- Auto-lock overlay -->
        <ContentControl Content="{Binding LockScreen}" Focusable="False" Visibility="{Binding LockScreen, Converter={StaticResource VisibleWhen}}" />

        <!-- Caption buttons (custom title bar) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" Panel.ZIndex="100">
            <Button Style="{StaticResource IconButton}" ToolTip="Simge durumuna küçült" Click="OnMinimize" Width="40">
                <Path Data="{StaticResource IconMinimize}" Style="{StaticResource Icon}" Width="12" Height="12" />
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="Ekranı kapla / Önceki boyut" Click="OnMaximize" Width="40">
                <Path Data="{StaticResource IconMaximize}" Style="{StaticResource Icon}" Width="12" Height="12" />
            </Button>
            <Button Style="{StaticResource IconButton}" ToolTip="Kapat" Click="OnClose" Width="40">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="12" Height="12" />
            </Button>
        </StackPanel>

        <!-- Exit backup indicator -->
        <Border x:Name="ClosingOverlay" Background="{StaticResource OverlayBrush}" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
                <TextBlock Text="Kapanmadan önce şifreli yedek alınıyor…" FontSize="15" />
            </Border>
        </Border>
    </Grid>
</Window>
