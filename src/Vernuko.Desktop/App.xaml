<Application x:Class="Vernuko.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vernuko.Desktop.Converters"
             xmlns:v="clr-namespace:Vernuko.Desktop.Views"
             xmlns:vm="clr-namespace:Vernuko.Presentation;assembly=Vernuko.Presentation"
             xmlns:pages="clr-namespace:Vernuko.Presentation.Pages;assembly=Vernuko.Presentation"
             xmlns:dialogs="clr-namespace:Vernuko.Presentation.Dialogs;assembly=Vernuko.Presentation"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:VisibleWhenConverter x:Key="VisibleWhen" />
            <c:InverseBoolConverter x:Key="Not" />
            <c:EnumEqualsConverter x:Key="EnumEquals" />
            <c:MoneyConverter x:Key="Money" />
            <c:DateFormatConverter x:Key="DateFormat" />
            <c:IconKeyConverter x:Key="IconKey" />
            <c:PercentArcConverter x:Key="PercentArc" />
            <c:ParametersConverter x:Key="Parameters" />
            <c:BytesToImageConverter x:Key="BytesToImage" />

            <!-- View-model → view mapping (MVVM, no code-behind logic). -->
            <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}"><v:SetupWizardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LockViewModel}"><v:LockView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShellViewModel}"><v:ShellView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:HomeViewModel}"><v:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:AppointmentsViewModel}"><v:AppointmentsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:AppointmentEditorViewModel}"><v:AppointmentEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:CustomersViewModel}"><v:CustomersView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:CatalogViewModel}"><v:CatalogView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:StaffViewModel}"><v:StaffView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:PackagesViewModel}"><v:PackagesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:PaymentsViewModel}"><v:PaymentsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:ReportsViewModel}"><v:ReportsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:SettingsViewModel}"><v:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:InventoryViewModel}"><v:InventoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:WaitlistViewModel}"><v:WaitlistView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:CommissionRulesViewModel}"><v:CommissionRulesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:ConsentTemplatesViewModel}"><v:ConsentTemplatesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:CustomerRecordsViewModel}"><v:CustomerRecordsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:PrivateNotesViewModel}"><v:PrivateNotesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:UpdatesViewModel}"><v:UpdatesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:MessagingSettingsViewModel}"><v:MessagingSettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:MultiComputerViewModel}"><v:MultiComputerView /></DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:PaymentDialogViewModel}"><v:PaymentDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:SellPackageDialogViewModel}"><v:SellPackageDialogView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
