<UserControl x:Class="Vernuko.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ctrl+N, Ctrl+L, Esc… are handled at window level (ShellView.xaml.cs → ShellViewModel.HandleShortcut), where the
         permission check and the "only Esc while a dialog is open" rule apply. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Top bar ===== -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                IsEnabled="{Binding Overlay, Converter={StaticResource IsNull}}">
            <Grid Margin="20,0,140,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/vernuko-256.png" Width="30" Height="30" />
                    <TextBlock Text="Vernuko" FontFamily="{StaticResource AppFontDisplay}" FontSize="24" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="40" Margin="8,0,16,0" ToolTip="{Binding ProfileName}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCrown}" Style="{StaticResource Icon}" />
                        <TextBlock Text="{Binding BusinessName}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Grid Grid.Column="2" MaxWidth="640" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBox x:Name="GlobalSearch" Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="38,0,70,0"
                             Tag="Müşteri ara (ad, telefon, müşteri no)…" AutomationProperties.Name="Genel arama">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding GlobalSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" TextElement.Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="{StaticResource NeutralSoftBrush}"
                            CornerRadius="5" Padding="7,3" IsHitTestVisible="False">
                        <TextBlock Text="Ctrl + K" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource IconButton}" ToolTip="Ekranı kilitle (Ctrl+L)" Command="{Binding LockCommand}">
                        <Path Data="{StaticResource IconLock}" Style="{StaticResource Icon}" />
                    </Button>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SelectionBrush}" Margin="10,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UserRoleName}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" ToolTip="Oturumu kapat" Command="{Binding LogoutCommand}" Margin="6,0,0,0">
                        <Path Data="{StaticResource IconLogout}" Style="{StaticResource Icon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Side navigation ===== -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                IsEnabled="{Binding Overlay, Converter={StaticResource IsNull}}">
            <DockPanel Margin="12,16,12,12">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Background="{StaticResource SurfaceAltBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource Icon}" />
                            <TextBlock Text="Lisans" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding LicenseText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource WarnBanner}" Margin="0,0,0,10" Visibility="{Binding IsDemo, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="DEMO MODU — örnek verilerle çalışıyorsunuz. Gerçek kayıtlarınız etkilenmez." TextWrapping="Wrap" FontSize="12.5" />
                </Border>
                <!-- Scrolls when the menu is longer than the window (11 items + license card on a 768 px screen at 125 %). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10" Focusable="False">
                    <ItemsControl ItemsSource="{Binding NavItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon, Converter={StaticResource IconKey}}" Style="{StaticResource Icon}" Width="20" Height="20" />
                                        <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Page ===== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" IsEnabled="{Binding Overlay, Converter={StaticResource IsNull}}" />

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding MessagingStatusText, Converter={StaticResource VisibleWhen}}">
                        <Path Data="{StaticResource IconSend}" Style="{StaticResource Icon}" Width="15" Height="15" />
                        <TextBlock Text="{Binding MessagingStatusText}" Margin="6,0,18,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Path Data="{StaticResource IconCloud}" Style="{StaticResource Icon}" Width="15" Height="15" />
                    <TextBlock Text="{Binding CloudBackupText}" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding VersionText}" Margin="18,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectionText}" Margin="8,0,18,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Path Data="{StaticResource IconShield}" Style="{StaticResource Icon}" Width="15" Height="15" />
                    <TextBlock Text="{Binding BackupStatusText}" Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupNeedsAttention}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Modal overlay (payment, package sale) ===== -->
        <!-- The page behind is disabled while it is open (Tab cannot reach it); a tall dialog scrolls on small screens. -->
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" Visibility="{Binding Overlay, Converter={StaticResource VisibleWhen}}"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
            <Border Style="{StaticResource Card}" Effect="{StaticResource PopupShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Margin="0,24" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="24">
                    <ContentControl Content="{Binding Overlay}" Focusable="False" />
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
