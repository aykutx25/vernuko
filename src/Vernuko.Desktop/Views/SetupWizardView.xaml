<UserControl x:Class="Vernuko.Desktop.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Vernuko.Desktop.Behaviors">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: brand + progress -->
        <Border Background="{StaticResource PrimaryBrush}">
            <DockPanel Margin="32,40,28,28">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Source="/Assets/vernuko-256.png" Width="36" Height="36" />
                    <TextBlock Text="Vernuko" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Foreground="#B8C3D9" FontSize="12.5" TextWrapping="Wrap"
                           Text="Verileriniz bu bilgisayarda saklanır. Vernuko çalışmak için internete ihtiyaç duymaz." />
                <StackPanel Margin="0,48,0,0">
                    <TextBlock Text="Kurulum" Foreground="#B8C3D9" FontSize="13" />
                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding StepIndex, Mode=OneWay}" /><Run Text=" / 10" />
                    </TextBlock>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,14,0,0" Foreground="#84B2E8" Background="#33FFFFFF" BorderThickness="0" />
                    <TextBlock Text="{Binding StepTitle}" Foreground="White" FontSize="17" Margin="0,20,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right: step content -->
        <Grid Grid.Column="1" Margin="56,48,56,32" MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepHint}" Style="{StaticResource Subtle}" FontSize="15" Margin="0,8,0,0" MaxWidth="700" HorizontalAlignment="Left" />
                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 1. Welcome -->
                    <StackPanel x:Name="Welcome" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Bu sihirbazda:" FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0" LineHeight="24" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="• İşletmenizin faaliyet alanını seçeceksiniz&#x0a;• Çalışma gün ve saatlerinizi belirleyeceksiniz&#x0a;• Personel ve hizmetlerinizi ekleyeceksiniz (atlanabilir)&#x0a;• Yönetici hesabınızı oluşturacaksınız&#x0a;• Şifreli yedekleme tercihinizi yapacaksınız" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Yedekten geri yükle…" Command="{Binding RestoreFromBackupCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Bilgisayar mı değiştiriyorsunuz?" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Eski bilgisayardan aldığınız Vernuko yedeğini (.vbk) ve kurtarma anahtarınızı kullanarak tüm kayıtlarınızı buraya taşıyın. Kurulum adımlarını yeniden yapmanız gerekmez." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Ana bilgisayara bağlan…" Command="{Binding ConnectToHostCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="İşletmenizde Vernuko başka bir bilgisayarda zaten kurulu mu?" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Bu bilgisayarı o bilgisayara (ana bilgisayar) bağlayın: aynı müşteriler, randevular ve kullanıcılar burada da görünür. Önce ana bilgisayarda Ayarlar › Çoklu bilgisayar › &quot;Bu bilgisayar ana bilgisayar olsun&quot; seçeneğini açın." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,16,0,0" Style="{StaticResource Muted}" Text="Sadece denemek mi istiyorsunuz? Vernuko'yu '--demo' parametresiyle başlatarak gerçek verilerinizden tamamen ayrı bir demo veritabanını kullanabilirsiniz." />
                    </StackPanel>

                    <!-- 2. Profile -->
                    <ItemsControl x:Name="Profile" Visibility="Collapsed" ItemsSource="{Binding Profiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Tile" Margin="0,0,10,10" Padding="16,12" HorizontalContentAlignment="Stretch" MinHeight="84"
                                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 3. Business -->
                    <StackPanel x:Name="Business" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="İŞLETME ADI *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Tag="Ör. Işıltı Güzellik ve Lazer" />
                        <TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Tag="0212 555 44 33" />
                        <TextBlock Text="ADRES" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
                    </StackPanel>

                    <!-- 4. Working days -->
                    <ItemsControl x:Name="WorkingDays" Visibility="Collapsed" ItemsSource="{Binding Days}" Focusable="False" MaxWidth="420" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOpen}" FontSize="15" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 5. Hours -->
                    <StackPanel x:Name="WorkingHours" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="AÇILIŞ" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OpenTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="KAPANIŞ" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CloseTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <CheckBox Content="Öğle arası var" IsChecked="{Binding HasBreak}" Margin="0,16,0,0" />
                        <UniformGrid Columns="2" Visibility="{Binding HasBreak, Converter={StaticResource VisibleWhen}}">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="ARA BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BreakStart, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ARA BİTİŞ" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BreakEnd, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 6. Staff -->
                    <StackPanel x:Name="Staff" Visibility="Collapsed" MaxWidth="620" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Staff}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Ad soyad" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Tag="Unvan (ör. Lazer Uzmanı)" Margin="0,0,8,0" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Kaldır"
                                                Command="{Binding DataContext.RemoveStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Personel ekle" HorizontalAlignment="Left" Command="{Binding AddStaffCommand}" />
                    </StackPanel>

                    <!-- 7. Services and resources -->
                    <StackPanel x:Name="Services" Visibility="Collapsed">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HİZMET" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="SÜRE (dk)" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="2" Text="FİYAT (₺)" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="3" Text="TEMİZLİK (dk)" Style="{StaticResource FieldLabel}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Services}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="2" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="3" Text="{Binding CleanupMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="Kaldır"
                                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Hizmet ekle" HorizontalAlignment="Left" Command="{Binding AddServiceCommand}" />

                        <TextBlock Text="Odalar ve cihazlar" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                        <ItemsControl ItemsSource="{Binding Resources}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" MaxWidth="560" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Kind}"
                                                  ItemsSource="{Binding DataContext.ResourceKinds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Kaldır"
                                                Command="{Binding DataContext.RemoveResourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Oda / cihaz ekle" HorizontalAlignment="Left" Command="{Binding AddResourceCommand}" />
                    </StackPanel>

                    <!-- 8. Admin -->
                    <StackPanel x:Name="Admin" Visibility="Collapsed" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="AD SOYAD *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="KULLANICI ADI *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Tag="ör. ayse" />
                        <TextBlock Text="PAROLA * (en az 8 karakter)" Style="{StaticResource FieldLabel}" />
                        <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="PAROLA (TEKRAR) *" Style="{StaticResource FieldLabel}" />
                        <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding AdminPasswordConfirm, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- 9. Backup -->
                    <StackPanel x:Name="Backup" Visibility="Collapsed" MaxWidth="620" HorizontalAlignment="Left">
                        <CheckBox Content="Şifreli otomatik yedeklemeyi etkinleştir (önerilir)" IsChecked="{Binding EnableBackup}" FontSize="15" />
                        <StackPanel Visibility="{Binding EnableBackup, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="YEDEK KLASÖRÜ" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Gözat…" Command="{Binding BrowseBackupFolderCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <Border Style="{StaticResource WarnBanner}" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" Text="Kurulumun sonunda size bir KURTARMA ANAHTARI gösterilecek. Bilgisayarınız bozulursa yedeklerinizi yalnızca bu anahtarla açabilirsiniz. Vernuko bu anahtarı saklamaz ve kurtaramaz." />
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Günlük yedek alınır (uygulama açıkken) ve uygulama kapanırken yedeklenir. Google Drive / OneDrive / Dropbox desteği sonraki sürümde eklenecektir." />
                        </StackPanel>
                    </StackPanel>

                    <!-- 10. Finish -->
                    <StackPanel x:Name="Finish" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel Visibility="{Binding RecoveryKey, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Kurtarma anahtarınız" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding RecoveryKey, Mode=OneWay}" Style="{StaticResource MonoTextBox}" Height="52" FontSize="18" HorizontalContentAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Panoya kopyala" Command="{Binding CopyRecoveryKeyCommand}" />
                            </StackPanel>
                            <Border Style="{StaticResource WarnBanner}" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" Text="Bu anahtarı kâğıda yazın ve bilgisayardan ayrı, güvenli bir yerde saklayın. Anahtarı kaybederseniz başka bir bilgisayarda yedeklerinizi açamazsınız." />
                            </Border>
                            <CheckBox Content="Kurtarma anahtarını güvenli bir yere yazdım" IsChecked="{Binding RecoveryKeyWrittenDown}" Margin="0,14,0,0" FontSize="15" />
                        </StackPanel>
                        <TextBlock Text="Her şey hazır. Vernuko'yu kullanmaya başlayabilirsiniz." FontSize="15" Margin="0,12,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Height="44" Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding StartUsingCommand}" Content="Vernuko'yu kullanmaya başla" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Navigation buttons -->
            <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="Finish"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Left" Content="Geri" Command="{Binding BackCommand}" MinWidth="110" Visibility="{Binding CanGoBack, Converter={StaticResource VisibleWhen}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="140" Height="42" Command="{Binding NextCommand}" IsDefault="True">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Devam" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastInputStep}" Value="True"><Setter Property="Text" Value="Kurulumu tamamla" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Bu adımı atla" Command="{Binding SkipCommand}" Margin="0,0,10,0"
                        Visibility="{Binding CanSkip, Converter={StaticResource VisibleWhen}}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
