<UserControl x:Class="Vernuko.Desktop.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Vernuko.Desktop.Behaviors">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Style="{StaticResource Card}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <Path Data="{StaticResource IconLock}" Style="{StaticResource Icon}" Width="34" Height="34" HorizontalAlignment="Center" />
                <TextBlock Text="Ekran kilitlendi" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding UserName, Mode=OneWay}" /><Run Text=" — devam etmek için parolanızı girin." />
                </TextBlock>
                <PasswordBox Margin="0,18,0,0" b:PasswordBoxAssistant.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.FocusOnLoad="True">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding UnlockCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Content="Kilidi aç" Height="42" Margin="0,14,0,0" Command="{Binding UnlockCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="Farklı kullanıcıyla giriş yap" Margin="0,8,0,0" Command="{Binding SwitchUserCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
