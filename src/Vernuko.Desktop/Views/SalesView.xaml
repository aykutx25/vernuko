<UserControl x:Class="Vernuko.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Satış" Style="{StaticResource PageTitle}" />
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource WarnBanner}" Margin="0,4,0,0">
                <TextBlock TextWrapping="Wrap" Text="Bu ekran yasal fiş kesmez. Perakende satışta fiş ya da fatura yazar kasa POS'tan (ÖKC) veya e-Arşiv faturadan düzenlenir; Vernuko burada stok, kasa ve müşteri hesabını tutar. Nasıl kullanacağınızı mali müşavirinize danışın." />
            </Border>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <TabControl Grid.Row="2" Margin="0,8,0,0">
            <TabItem Header="Yeni satış">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="290" MaxWidth="360" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="BARKOD, ÜRÜN KODU VEYA AD (FİYATLAR KDV DAHİL)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <Grid>
                                    <TextBox x:Name="Code" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Tag="Barkodu okutun ya da yazıp Enter'a basın" Padding="34,0,10,0" FontSize="15" AutomationProperties.Name="Barkod veya ürün">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddCodeCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="15" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" TextElement.Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" Visibility="{Binding ProductResults.Count, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl ItemsSource="{Binding ProductResults}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ListRowButton}" Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SalePriceMinor, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"><Run Text="Stok " /><Run Text="{Binding StockText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Barcode, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" /></TextBlock>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" Style="{StaticResource WarnBanner}" Margin="0,8,0,0" Visibility="{Binding HasStockWarning, Converter={StaticResource VisibleWhen}}">
                                <TextBlock TextWrapping="Wrap" Text="Bazı satırlarda rafta görünenden fazla ürün var. Satış yine kaydedilir; stok eksiye düşer ve sayımda düzeltilir." />
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Sepet boş. Barkodu okutun ya da ürünün adını yazıp listeden seçin."
                                       Visibility="{Binding Cart.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <DataGrid ItemsSource="{Binding Cart}" Margin="0,12,0,0" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Sepet">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ürün" Binding="{Binding Product.Name, Mode=OneWay}" Width="*" MinWidth="130" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Adet" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                    <DataGridTextColumn Header="Birim fiyat" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    <DataGridTextColumn Header="İndirim" Binding="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <DataGridTextColumn Header="Tutar" Binding="{Binding TotalText, Mode=OneWay}" Width="100" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="Kaldır" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <!-- Total and the buttons stay at the bottom of the card: inside the scroller they fell below 768 px. -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Toplam" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding PaymentText}" Margin="0,2,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Satışı tamamla" Command="{Binding CompleteCommand}" Margin="0,10,0,0" Padding="16,10" HorizontalAlignment="Stretch" />
                                <Button Style="{StaticResource GhostButton}" Content="Sepeti boşalt" Command="{Binding NewSaleCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Müşteri" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Boş bırakın: kayıtsız müşteri" AutomationProperties.Name="Müşteri ara" />
                                </Grid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" Visibility="{Binding CustomerResults.Count, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl ItemsSource="{Binding CustomerResults}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ListRowButton}" Command="{Binding DataContext.PickCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Phone}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Kaldır" Command="{Binding ClearCustomerCommand}" Visibility="{Binding IsWalkIn, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                    <TextBlock Text="{Binding CustomerText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="BELGE İNDİRİMİ (₺)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DocumentDiscount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Belge indirimi" />
                                <UniformGrid Columns="3" Margin="0,4,0,0">
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="NAKİT" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Cash, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nakit" /></StackPanel>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="KART" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Card, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kart" /></StackPanel>
                                    <StackPanel><TextBlock Text="HAVALE" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Transfer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Havale" /></StackPanel>
                                </UniformGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Tamamı nakit" Command="{Binding AllCashCommand}" Margin="0,0,8,0" />
                                    <Button Content="Tamamı kart" Command="{Binding AllCardCommand}" />
                                </WrapPanel>
                                <TextBlock Text="NOT" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Bugün ve iade">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="400" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,10" DataContext="{Binding Today}">
                        <StackPanel>
                            <TextBlock Text="Gün sonu" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Columns="4">
                                <StackPanel><TextBlock Text="NET SATIŞ" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding NetSalesMinor, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel><TextBlock Text="NAKİT" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding CashMinor, Converter={StaticResource Money}}" FontSize="18" /></StackPanel>
                                <StackPanel><TextBlock Text="KART" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding CardMinor, Converter={StaticResource Money}}" FontSize="18" /></StackPanel>
                                <StackPanel><TextBlock Text="VERESİYE" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding OnAccountMinor, Converter={StaticResource Money}}" FontSize="18" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding SaleCount, Mode=OneWay}" /><Run Text=" satış, " /><Run Text="{Binding ReturnCount, Mode=OneWay}" /><Run Text=" iade. Havale " /><Run Text="{Binding TransferMinor, Mode=OneWay, Converter={StaticResource Money}}" /><Run Text="." />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Visibility="{Binding ShowsCost, Converter={StaticResource VisibleWhen}}"><Run Text="Tahmini brüt kâr (KDV hariç satış − maliyet): " /><Run Text="{Binding GrossProfitMinor, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                            <ItemsControl ItemsSource="{Binding Vat}" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="KDV %" /><Run Text="{Binding Rate, Mode=OneWay}" /><Run Text=": satış " /><Run Text="{Binding GrossMinor, Mode=OneWay, Converter={StaticResource Money}}" /><Run Text=", KDV " /><Run Text="{Binding VatMinor, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                        <DataGrid ItemsSource="{Binding TodaySales}" SelectedItem="{Binding SelectedSale}" AutomationProperties.Name="Bugünkü satışlar">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" Binding="{Binding Number}" Width="130" />
                                <DataGridTextColumn Header="Saat" Binding="{Binding AtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" Width="130" />
                                <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="*" />
                                <DataGridTextColumn Header="Kalem" Binding="{Binding ItemCount}" Width="60" />
                                <DataGridTextColumn Header="Tutar" Binding="{Binding TotalMinor, Converter={StaticResource Money}}" Width="110" />
                                <DataGridTextColumn Header="Hesaba" Binding="{Binding OnAccountMinor, Converter={StaticResource Money}}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Satış ayrıntısı ve iade" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Soldan bir satış seçin." Visibility="{Binding SaleDetail, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                <StackPanel Visibility="{Binding SaleDetail, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding SaleDetail.Number, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SaleDetail.CustomerName, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" Visibility="{Binding SaleDetail.ReturnOfNumber, Converter={StaticResource VisibleWhen}}"><Run Text="İade edilen satış: " /><Run Text="{Binding SaleDetail.ReturnOfNumber, Mode=OneWay}" /></TextBlock>
                                    <ItemsControl ItemsSource="{Binding SaleDetail.Lines}" Margin="0,6,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalMinor, Converter={StaticResource Money}}" />
                                                    <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding ProductName, Mode=OneWay}" /></TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold"><Run Text="Toplam " /><Run Text="{Binding SaleDetail.TotalMinor, Mode=OneWay, Converter={StaticResource Money}}" /><Run Text=" (KDV " /><Run Text="{Binding SaleDetail.VatMinor, Mode=OneWay, Converter={StaticResource Money}}" /><Run Text=")" /></TextBlock>

                                    <StackPanel Visibility="{Binding ReturnRows.Count, Converter={StaticResource VisibleWhen}}">
                                        <Separator Margin="0,12" />
                                        <TextBlock Text="İade al" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Geri gelen adetleri yazın; ürün stoğa döner. Kayıtsız müşteride iadenin tamamı nakit verilir. Kayıtlı müşteride nakit vermediğiniz kısım hesabına alacak yazılır." />
                                        <ItemsControl ItemsSource="{Binding ReturnRows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="İade adedi" />
                                                        <TextBlock DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"><Run Text="en çok " /><Run Text="{Binding Line.ReturnableQuantity, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding Line.ProductName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="NAKİT İADE (₺)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding RefundCash, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="İadeyi kaydet" Command="{Binding ReturnCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" IsEnabled="{Binding CanReturn}" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Text="İade almak için iptal/iade yetkisi gerekir." Visibility="{Binding CanReturn, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
