<UserControl x:Class="Vernuko.Desktop.Views.CommissionRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tür" Binding="{Binding BasisName}" Width="140" />
                        <DataGridTextColumn Header="Personel" Binding="{Binding StaffName}" Width="*" />
                        <DataGridTextColumn Header="Hizmet / ürün" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="Oran" Binding="{Binding RateText}" Width="100" />
                        <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive, Mode=OneWay}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="+ Yeni" Command="{Binding NewCommand}" />
                            <TextBlock Text="Prim kuralı" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="NE İÇİN" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding BasisOptions}" SelectedItem="{Binding Basis}" DisplayMemberPath="Label" />
                        <TextBlock Text="PERSONEL" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding Staff}" DisplayMemberPath="Label" />
                        <TextBlock Text="HİZMET / ÜRÜN" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ItemOptions}" SelectedItem="{Binding Item}" DisplayMemberPath="Label" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="HESAPLAMA" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding RateKindOptions}" SelectedItem="{Binding RateKind}" DisplayMemberPath="Label" /></StackPanel>
                            <StackPanel><TextBlock Text="DEĞER" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </UniformGrid>
                        <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="En özel kural geçerlidir: personel + hizmet &gt; yalnız personel &gt; yalnız hizmet &gt; genel kural. Hizmet primi randevu tamamlanınca, paket/ürün primi satışta hesaplanır. Kural değişikliği geçmiş primleri değiştirmez." />
                        <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveCommand}" Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="120" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
