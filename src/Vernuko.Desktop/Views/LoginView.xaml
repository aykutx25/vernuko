<UserControl x:Class="Vernuko.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Vernuko.Desktop.Behaviors">
    <Grid>
        <Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Assets/vernuko-256.png" Width="38" Height="38" />
                    <TextBlock Text="Vernuko" FontSize="28" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding BusinessName}" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" />
                <Border Style="{StaticResource WarnBanner}" Margin="0,16,0,0" Visibility="{Binding IsDemo, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding DemoHint}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="KULLANICI ADI" Style="{StaticResource FieldLabel}" Margin="0,22,0,4" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.FocusOnLoad="True" AutomationProperties.Name="Kullanıcı adı" />
                <TextBlock Text="PAROLA" Style="{StaticResource FieldLabel}" />
                <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Parola">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Content="Giriş yap" Height="44" Margin="0,18,0,0" Command="{Binding LoginCommand}" IsDefault="True" />
                <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
