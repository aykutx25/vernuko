<UserControl x:Class="Vernuko.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Alış ve Tedarikçiler" Style="{StaticResource PageTitle}" />
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource WarnBanner}" Margin="0,8,0,0" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <TextBlock Text="Alış kayıtlarını görüntüleyebilirsiniz; mal kabul ve tedarikçi ödemesi için yetki gerekir." />
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,14,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="+ Yeni" Command="{Binding NewSupplierCommand}" IsEnabled="{Binding CanManage}" />
                        <TextBlock Text="Tedarikçiler" Style="{StaticResource SectionTitle}" Margin="0" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Style="{StaticResource PlainListBox}" Margin="6,0,6,6" AutomationProperties.Name="Tedarikçiler">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceMinor, Converter={StaticResource Money}}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <TabControl Grid.Column="1">
                <TabItem Header="Mal kabul">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                    <Run Text="Tedarikçi: " /><Run Text="{Binding SelectedSupplier.Name, Mode=OneWay, TargetNullValue='soldan seçin'}" FontWeight="SemiBold" /><Run Text=". Fiyatları faturadaki gibi KDV hariç girin." />
                                </TextBlock>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="FATURA / İRSALİYE NO" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DocumentNo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="BELGE TARİHİ" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding DocumentDate}" AutomationProperties.Name="Belge tarihi" /></StackPanel>
                                    <StackPanel><TextBlock Text="ÜRÜN (BARKOD, KOD, AD)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Tag="Okutun, Enter" AutomationProperties.Name="Ürün ara">
                                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCodeCommand}" /></TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>
                                </UniformGrid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" Visibility="{Binding ProductResults.Count, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl ItemsSource="{Binding ProductResults}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ListRowButton}" Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}"><Run Text="Stok " /><Run Text="{Binding StockText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <TextBlock Text="{Binding TotalsText}" FontWeight="SemiBold" FontSize="15" />
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Ürün maliyetlerini bu faturaya göre güncelle" IsChecked="{Binding UpdateCosts}" VerticalAlignment="Center" Margin="0,0,16,6" />
                                    <TextBlock Text="Şimdi ödenen (₺)" VerticalAlignment="Center" Margin="0,0,6,6" />
                                    <TextBox Text="{Binding PayNow, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,6,6" AutomationProperties.Name="Şimdi ödenen" />
                                    <ComboBox ItemsSource="{Binding PayMethods}" SelectedItem="{Binding PayMethod}" DisplayMemberPath="Label" Width="140" Margin="0,0,0,6" AutomationProperties.Name="Ödeme yöntemi" />
                                </WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Mal kabulü kaydet" Command="{Binding SaveReceiptCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" IsEnabled="{Binding CanManage}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Kayıtla birlikte stok artar, tedarikçinin hesabına borç yazılır; ödenen kısım düşülür." />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Lines}" Margin="0,10,0,0" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Alış kalemleri">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ürün" Binding="{Binding Product.Name, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Adet" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridTextColumn Header="Birim maliyet (KDV hariç)" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                    <DataGridComboBoxColumn Header="KDV %" SelectedItemBinding="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}" Width="70">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.VatRates, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.VatRates, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="İndirim" Binding="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="Tutar (KDV hariç)" Binding="{Binding NetText, Mode=OneWay}" Width="120" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="Kaldır" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Tedarikçi bilgisi ve hesap">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Tedarikçi" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="UNVAN" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="VERGİ DAİRESİ" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TaxOffice, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        <StackPanel><TextBlock Text="VKN / TCKN" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="IBAN" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" Tag="TR.." />
                                    <TextBlock Text="NOT" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SupplierNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveSupplierCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="{Binding CanManage}" />

                                    <StackPanel Visibility="{Binding SelectedSupplier, Converter={StaticResource VisibleWhen}}">
                                        <Separator Margin="0,14" />
                                        <TextBlock Text="Tedarikçiye ödeme" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="Bakiye (borcunuz): " /><Run Text="{Binding SelectedSupplier.BalanceMinor, Mode=OneWay, Converter={StaticResource Money}}" FontWeight="SemiBold" /></TextBlock>
                                        <UniformGrid Columns="2" Margin="0,4,0,0">
                                            <StackPanel Margin="0,0,6,0"><TextBlock Text="TUTAR (₺)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel><TextBlock Text="YÖNTEM" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding PayMethods}" SelectedItem="{Binding PayMethod}" DisplayMemberPath="Label" /></StackPanel>
                                        </UniformGrid>
                                        <Button Content="Ödemeyi kaydet" Command="{Binding PaySupplierCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding CanManage}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Hesap hareketleri" Style="{StaticResource SectionTitle}" Margin="14,12,14,6" />
                                <DataGrid ItemsSource="{Binding Statement.Entries}" AutomationProperties.Name="Tedarikçi hesap hareketleri">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding AtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" Width="130" />
                                        <DataGridTextColumn Header="Belge" Binding="{Binding DocumentNumber}" Width="130" />
                                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" />
                                        <DataGridTextColumn Header="Tutar" Binding="{Binding BalanceEffectMinor, Converter={StaticResource Money}}" Width="110" />
                                        <DataGridTextColumn Header="Bakiye" Binding="{Binding RunningBalanceMinor, Converter={StaticResource Money}}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Son alışlar">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding RecentReceipts}" AutomationProperties.Name="Son alışlar">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" Binding="{Binding Number}" Width="130" />
                                <DataGridTextColumn Header="Belge tarihi" Binding="{Binding DocumentDate, Converter={StaticResource DateFormat}, ConverterParameter=date}" Width="100" />
                                <DataGridTextColumn Header="Tedarikçi" Binding="{Binding SupplierName}" Width="*" />
                                <DataGridTextColumn Header="Fatura no" Binding="{Binding DocumentNo}" Width="120" />
                                <DataGridTextColumn Header="Kalem" Binding="{Binding ItemCount}" Width="60" />
                                <DataGridTextColumn Header="KDV hariç" Binding="{Binding NetMinor, Converter={StaticResource Money}}" Width="110" />
                                <DataGridTextColumn Header="Toplam" Binding="{Binding TotalMinor, Converter={StaticResource Money}}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
