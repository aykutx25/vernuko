<UserControl x:Class="Vernuko.Desktop.Views.ConsentTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource WarnBanner}"><TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Form" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Sürüm" Binding="{Binding TextVersion}" Width="60" />
                        <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive, Mode=OneWay}" Width="55" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="+ Yeni" Command="{Binding NewCommand}" />
                        <TextBlock Text="Onam / bilgilendirme formu" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="BAŞLIK" Style="{StaticResource FieldLabel}" />
                    <TextBox DockPanel.Dock="Top" Text="{Binding TemplateTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Aktif (müşteri kartında seçilebilir)" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveCommand}" MinWidth="120" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="METİN" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" MinHeight="220" VerticalAlignment="Stretch" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
