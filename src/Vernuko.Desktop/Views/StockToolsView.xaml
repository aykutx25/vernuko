<UserControl x:Class="Vernuko.Desktop.Views.StockToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            <TextBlock Text="Sayım ve Sipariş" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,10" DataContext="{Binding Value}" Visibility="{Binding Converter={StaticResource VisibleWhen}}">
            <UniformGrid Columns="4">
                <StackPanel><TextBlock Text="ÜRÜN ÇEŞİDİ" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding ProductCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                <StackPanel><TextBlock Text="RAFTAKİ ADET" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding UnitCount}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                <StackPanel><TextBlock Text="MALİYET DEĞERİ" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding CostValueMinor, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                <StackPanel><TextBlock Text="SATIŞ DEĞERİ" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding SaleValueMinor, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </UniformGrid>
        </Border>
        <TabControl Grid.Row="3">
            <TabItem Header="Sayım">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Rafta saydığınız miktarı yazın. Boş bıraktığınız ürünler değişmez. Kaydettiğinizde yalnızca farklar, sayım düzeltmesi olarak stok hareketine yazılır." />
                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Ürün adı, barkod veya raf ile süzün" Margin="0,8,0,0" AutomationProperties.Name="Süz" />
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Sayımı kaydet" Command="{Binding ApplyCountCommand}" IsEnabled="{Binding CanManage}" />
                            <TextBox Text="{Binding CountNote, UpdateSourceTrigger=PropertyChanged}" Tag="Not (ör. yıl sonu sayımı)" Margin="0,0,10,0" AutomationProperties.Name="Sayım notu" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding VisibleRows}" Margin="0,10,0,0" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Sayım listesi">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ürün" Binding="{Binding Product.Name, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Barkod" Binding="{Binding Product.Barcode, Mode=OneWay}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Raf" Binding="{Binding Product.ShelfLocation, Mode=OneWay}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Kayıtlı" Binding="{Binding Product.Stock, Mode=OneWay}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Sayılan" Binding="{Binding Counted, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="Fark" Binding="{Binding DifferenceText, Mode=OneWay}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="Sipariş önerisi">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Kritik seviyenin altına düşen ürünler, tedarikçiye göre gruplanır. Önerilen miktar stoğu kritik seviyenin iki katına tamamlar." />
                        <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" Text="Şu an sipariş gerektiren ürün yok." Visibility="{Binding Reorder.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Reorder}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,10">
                                            <TextBlock Text="{Binding SupplierName}" Style="{StaticResource SectionTitle}" />
                                            <DataGrid ItemsSource="{Binding Lines}" HeadersVisibility="Column">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="*" />
                                                    <DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="130" />
                                                    <DataGridTextColumn Header="Stok" Binding="{Binding Stock}" Width="60" />
                                                    <DataGridTextColumn Header="Kritik" Binding="{Binding MinimumStock}" Width="60" />
                                                    <DataGridTextColumn Header="Önerilen" Binding="{Binding SuggestedQuantity}" Width="80" />
                                                    <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="60" />
                                                    <DataGridTextColumn Header="Son maliyet" Binding="{Binding LastCostMinor, Converter={StaticResource Money}}" Width="100" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
