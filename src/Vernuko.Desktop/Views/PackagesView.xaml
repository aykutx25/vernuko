<UserControl x:Class="Vernuko.Desktop.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Vernuko.Presentation.Pages;assembly=Vernuko.Presentation">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SellCommand}" Height="42">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" /><TextBlock Text="Paket satışı" Margin="8,0,0,0" /></StackPanel>
            </Button>
            <TextBlock Text="Paket &amp; Seanslar" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <WrapPanel Grid.Row="2" Margin="0,12,0,8">
            <Grid Width="320" Margin="0,0,12,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Müşteri adı veya telefon" Padding="34,0,10,0" />
                <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="15" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" TextElement.Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
            <CheckBox Content="Yalnızca aktif paketler" IsChecked="{Binding ActiveOnly}" VerticalAlignment="Center" />
        </WrapPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Paket" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="Kullanılan" Binding="{Binding UsedSessions}" Width="90" />
                        <DataGridTextColumn Header="Kalan" Binding="{Binding RemainingSessions}" Width="70" />
                        <DataGridTextColumn Header="Planlı" Binding="{Binding UpcomingBooked}" Width="70" />
                        <DataGridTextColumn Header="Geçerlilik" Binding="{Binding ExpiresAtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-date}" Width="100" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusName}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Ayrıntı için listeden bir paket seçin." Style="{StaticResource Muted}" Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <DockPanel Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Selected.Label}" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="{Binding Selected.CustomerName}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <StackPanel><TextBlock Text="{Binding Selected.TotalSessions}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Toplam" Style="{StaticResource Muted}" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding Selected.UsedSessions}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Kullanılan" Style="{StaticResource Muted}" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding Selected.RemainingSessions}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" /><TextBlock Text="Kalan" Style="{StaticResource Muted}" /></StackPanel>
                            </UniformGrid>
                            <WrapPanel Margin="0,14,0,0" Visibility="{Binding CanAdjust, Converter={StaticResource VisibleWhen}}">
                                <Button Content="Seans düzelt" Command="{Binding AdjustCommand}" Margin="0,0,6,6" />
                                <Button Content="Dondur / Aç" Command="{Binding ToggleFreezeCommand}" Margin="0,0,6,6" />
                                <Button Content="Süre uzat" Command="{Binding ExtendCommand}" Margin="0,0,6,6" />
                                <Button Style="{StaticResource DangerButton}" Content="İptal" Command="{Binding CancelPackageCommand}" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Text="Seans geçmişi" FontWeight="SemiBold" Margin="0,12,0,6" />
                        </StackPanel>
                        <!-- The whole session history, not only the first few entries that fit. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Ledger}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Delta, StringFormat={}{0:+0;-0;0}}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Muted}">
                                                    <Run Text="{Binding KindName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UserName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Visibility="{Binding Reason, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
