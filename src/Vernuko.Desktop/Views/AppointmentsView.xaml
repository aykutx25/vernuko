<UserControl x:Class="Vernuko.Desktop.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Vernuko.Presentation.Pages;assembly=Vernuko.Presentation">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseEditorCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousPeriodCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextPeriodCommand}" />
        <KeyBinding Key="T" Modifiers="Alt" Command="{Binding TodayCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- Day list rows -->
        <DataTemplate DataType="{x:Type pages:AppointmentRow}">
            <Border x:Name="Row" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,6" MinHeight="58">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*" MinWidth="170" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" MinWidth="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TimeBadge" CornerRadius="7" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="{Binding TimeText}" FontSize="16" FontWeight="SemiBold" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatusBar}" />
                    <StackPanel Grid.Column="2" Margin="14,8,8,8" VerticalAlignment="Center">
                        <Button Style="{StaticResource LinkButton}" Command="{Binding DataContext.OpenCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Müşteri kartını aç">
                            <TextBlock Text="{Binding Customer}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding Phone, Converter={StaticResource VisibleWhen}}">
                            <Path Data="{StaticResource IconPhone}" Style="{StaticResource Icon}" Width="13" Height="13" TextElement.Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Phone}" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Data="{StaticResource IconLeaf}" Style="{StaticResource Icon}" TextElement.Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding ServiceLine}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BodyArea}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding BodyArea, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="↻ Tekrarlayan seri" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsInSeries, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUser}" Style="{StaticResource Icon}" Width="14" Height="14" TextElement.Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Staff}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding Resources, Converter={StaticResource VisibleWhen}}">
                            <Path Data="{StaticResource IconRoom}" Style="{StaticResource Icon}" Width="14" Height="14" TextElement.Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Resources}" Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="5" Style="{StaticResource StatusChip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusName}" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" ToolTip="İşlemler" Click="OnRowMenu" AutomationProperties.Name="Randevu işlemleri">
                        <Path Data="{StaticResource IconMore}" Style="{StaticResource IconDots}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource InfoSoftBrush}" />
                    <Setter TargetName="TimeBadge" Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter TargetName="TimeText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusGroup}" Value="Done">
                    <Setter TargetName="Row" Property="Background" Value="#F6FBF8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusGroup}" Value="Off">
                    <Setter TargetName="Row" Property="Opacity" Value="0.65" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BreakRow}">
            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,6" MinHeight="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <Path Data="{StaticResource IconCoffee}" Style="{StaticResource Icon}" TextElement.Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RangeText}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Randevular" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding DateTitle}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="View" IsChecked="{Binding View, Converter={StaticResource EnumEquals}, ConverterParameter=Day}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" Width="15" Height="15" /><TextBlock Text="Gün" Margin="8,0,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="View" IsChecked="{Binding View, Converter={StaticResource EnumEquals}, ConverterParameter=Week}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" Width="15" Height="15" /><TextBlock Text="Hafta" Margin="8,0,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="View" IsChecked="{Binding View, Converter={StaticResource EnumEquals}, ConverterParameter=Month}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" Width="15" Height="15" /><TextBlock Text="Ay" Margin="8,0,0,0" /></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="44" Command="{Binding NewAppointmentCommand}" ToolTip="Yeni randevu (Ctrl+N)" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" />
                        <TextBlock Text="Yeni Randevu" Margin="10,0,0,0" FontSize="15" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Summary cards (day view) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,0">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding View}" Value="Week"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding View}" Value="Month"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource InfoSoftBrush}"><Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" TextElement.Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary.Total}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Günün randevusu" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource WarningSoftBrush}"><Path Data="{StaticResource IconHourglass}" Style="{StaticResource Icon}" TextElement.Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary.Open}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Bekleyen" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource SuccessSoftBrush}"><Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" TextElement.Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary.Completed}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Tamamlanan" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource NeutralSoftBrush}"><Path Data="{StaticResource IconUsers}" Style="{StaticResource Icon}" HorizontalAlignment="Center" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveStaffCount}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Aktif personel" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Toolbar -->
            <WrapPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal">
                <Border BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="{Binding PreviousPeriodCommand}" ToolTip="Önceki (Alt+←)"><Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource Icon}" Width="14" /></Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextPeriodCommand}" ToolTip="Sonraki (Alt+→)"><Path Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon}" Width="14" /></Button>
                    </StackPanel>
                </Border>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="170" Margin="0,0,10,6" AutomationProperties.Name="Tarih" />
                <Button Content="Bugün" Command="{Binding TodayCommand}" Margin="0,0,10,6" ToolTip="Alt+T" />
                <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="Label" Width="170" Margin="0,0,10,6" AutomationProperties.Name="Personel filtresi" />
                <ComboBox ItemsSource="{Binding ResourceOptions}" SelectedItem="{Binding SelectedResource}" DisplayMemberPath="Label" Width="170" Margin="0,0,10,6" AutomationProperties.Name="Oda filtresi" />
                <ComboBox ItemsSource="{Binding ServiceOptions}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="Label" Width="190" Margin="0,0,10,6" AutomationProperties.Name="Hizmet filtresi" />
                <Button Style="{StaticResource GhostButton}" Content="Filtreleri temizle" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,6" />
            </WrapPanel>

            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
                <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
            </StackPanel>

            <!-- Day view -->
            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding View}" Value="Week"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding View}" Value="Month"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" VirtualizingPanel.IsVirtualizing="True" />
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" Width="40" Height="40" TextElement.Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Bu gün için randevu yok." Margin="0,10,0,0" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="İşletme bu gün kapalı görünüyor." Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsClosedDay, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Grid>

            <!-- Week view -->
            <ScrollViewer Grid.Row="4" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding View}" Value="Week"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding WeekDays}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Col" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,5" Margin="0,0,0,5">
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding StartLocal, Converter={StaticResource DateFormat}, ConverterParameter=time, Mode=OneWay}" />
                                                            <Run Text="·" />
                                                            <Run Text="{Binding StaffName, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ServiceName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusName}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Col" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Month view -->
            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding View}" Value="Month"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="7" Margin="0,0,0,6">
                    <TextBlock Text="Pzt" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sal" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Çar" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Per" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Cum" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Cmt" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Paz" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </UniformGrid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthCells}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Cell" Margin="0,0,5,5" Padding="8,6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <Grid>
                                    <TextBlock x:Name="Num" Text="{Binding DayNumber}" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding CountText}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                    <Setter TargetName="Cell" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- ===== Right column: editor OR compact summary ===== -->
        <ContentControl Grid.Column="1" Width="392" Margin="18,0,0,0" Content="{Binding Editor}" Focusable="False" Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleWhen}}" />
        <ScrollViewer Grid.Column="1" Width="330" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" />
                            <TextBlock Text="Hızlı İşlemler" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource TileButton}" Margin="0,0,6,6" Command="{Binding NewAppointmentCommand}">
                                <StackPanel><Path Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" Width="22" Height="22" HorizontalAlignment="Center" /><TextBlock Text="Yeni Randevu" Margin="0,6,0,0" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,6,6" Command="{Binding GoCommand}" CommandParameter="customers">
                                <StackPanel><Path Data="{StaticResource IconUser}" Style="{StaticResource Icon}" Width="22" Height="22" HorizontalAlignment="Center" /><TextBlock Text="Müşteriler" Margin="0,6,0,0" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,0,6" Command="{Binding GoCommand}" CommandParameter="packages">
                                <StackPanel><Path Data="{StaticResource IconLayers}" Style="{StaticResource Icon}" Width="22" Height="22" HorizontalAlignment="Center" /><TextBlock Text="Paket Satışı" Margin="0,6,0,0" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,6,0" Command="{Binding GoCommand}" CommandParameter="payments">
                                <StackPanel><Path Data="{StaticResource IconCard}" Style="{StaticResource Icon}" Width="22" Height="22" HorizontalAlignment="Center" /><TextBlock Text="Ödeme Al" Margin="0,6,0,0" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,6,0" Command="{Binding GoCommand}" CommandParameter="reports">
                                <StackPanel><Path Data="{StaticResource IconChart}" Style="{StaticResource Icon}" Width="22" Height="22" HorizontalAlignment="Center" /><TextBlock Text="Raporlar" Margin="0,6,0,0" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Command="{Binding RefreshCommand}" ToolTip="F5">
                                <StackPanel><Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="22" Height="22" HorizontalAlignment="Center" /><TextBlock Text="Yenile" Margin="0,6,0,0" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Path Data="{StaticResource IconClock}" Style="{StaticResource Icon}" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource NeutralSoftBrush}" CornerRadius="6" Padding="8,1">
                                <TextBlock Text="{Binding Upcoming.Count}" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="Yaklaşan Randevular" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartLocal, Converter={StaticResource DateFormat}, ConverterParameter=time}" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ServiceName}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Yaklaşan randevu yok." Style="{StaticResource Muted}" Visibility="{Binding Upcoming.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconChart}" Style="{StaticResource Icon}" />
                            <TextBlock Text="Günün Özeti" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96">
                                <Viewbox>
                                    <Canvas Width="110" Height="110">
                                        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="100" Height="100" Stroke="{StaticResource NeutralSoftBrush}" StrokeThickness="10" />
                                        <Path Data="{Binding Summary.CompletionPercent, Converter={StaticResource PercentArc}}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold">
                                    <Run Text="%" /><Run Text="{Binding Summary.CompletionPercent, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel Margin="0,3">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.Completed}" FontWeight="SemiBold" />
                                    <TextBlock Text="Tamamlanan" Margin="8,0,0,0" />
                                </DockPanel>
                                <DockPanel Margin="0,3">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.Open}" FontWeight="SemiBold" />
                                    <TextBlock Text="Bekleyen" Margin="8,0,0,0" />
                                </DockPanel>
                                <DockPanel Margin="0,3">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource BorderStrongBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.Cancelled}" FontWeight="SemiBold" />
                                    <TextBlock Text="İptal" Margin="8,0,0,0" />
                                </DockPanel>
                                <DockPanel Margin="0,3">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.NoShow}" FontWeight="SemiBold" />
                                    <TextBlock Text="Gelmedi" Margin="8,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
