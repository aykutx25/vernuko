<UserControl x:Class="Vernuko.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Listeyi dışa aktar (CSV)" Command="{Binding ExportAllCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Height="42">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" /><TextBlock Text="Yeni müşteri" Margin="8,0,0,0" /></StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Müşteriler" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Ad, telefon veya müşteri no" Padding="34,0,10,0" />
                            <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="15" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" TextElement.Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                        <CheckBox Content="Arşivdekileri de göster" IsChecked="{Binding IncludeArchived}" Margin="2,8,0,6" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Phone}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                        <Run Text="#" /><Run Text="{Binding Number, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail / edit -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Edit form -->
                    <Border Style="{StaticResource Card}" Padding="20" Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhen}}">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                        <Setter Property="Text" Value="Müşteriyi düzenle" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Text" Value="Yeni müşteri" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="AD *" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="SOYAD" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Tag="0532 123 45 67" /></StackPanel>
                                <StackPanel><TextBlock Text="E-POSTA" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="DOĞUM TARİHİ" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding BirthDate}" /></StackPanel>
                                <StackPanel Visibility="{Binding CanSeeSensitive, Converter={StaticResource VisibleWhen}}"><TextBlock Text="T.C. KİMLİK NO (isteğe bağlı)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <StackPanel Visibility="{Binding ShowCompany, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="FİRMA UNVANI" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Firma unvanı" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="VERGİ DAİRESİ" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TaxOffice, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Vergi dairesi" /></StackPanel>
                                    <StackPanel><TextBlock Text="VKN / TCKN" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Tag="10 haneli VKN" AutomationProperties.Name="Vergi numarası" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <TextBlock Text="ADRES" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="NOTLAR" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
                            <TextBlock Text="İLETİŞİM TERCİHLERİ (randevu bildirimleri)" Style="{StaticResource FieldLabel}" />
                            <WrapPanel>
                                <CheckBox Content="SMS" IsChecked="{Binding AllowSms}" Margin="0,4,18,4" />
                                <CheckBox Content="WhatsApp" IsChecked="{Binding AllowWhatsApp}" Margin="0,4,18,4" />
                                <CheckBox Content="E-posta" IsChecked="{Binding AllowEmail}" Margin="0,4,18,4" />
                            </WrapPanel>
                            <CheckBox Content="Kampanya / tanıtım mesajı almayı kabul ediyor (ticari ileti onayı — İYS)" IsChecked="{Binding MarketingConsent}" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveCommand}" MinWidth="120" />
                                <Button Content="Vazgeç" Command="{Binding CancelEditCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Read-only detail -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Randevu ver" Command="{Binding NewAppointmentCommand}" Margin="0,0,8,0" />
                                        <Button Content="Düzenle" Command="{Binding EditCommand}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Details.FullName}" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                            <Run Text="Müşteri #" /><Run Text="{Binding Details.Number, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Details.Phone, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Details.Email, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Details.Notes}" Style="{StaticResource Subtle}" Margin="0,10,0,0" Visibility="{Binding Details.Notes, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding Details.CompanyLine}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding Details.CompanyLine, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Margin="0,8,0,0" Visibility="{Binding Details.NationalIdMasked, Converter={StaticResource VisibleWhen}}" Style="{StaticResource Muted}">
                                    <Run Text="T.C.: " /><Run Text="{Binding Details.NationalIdMasked, Mode=OneWay}" />
                                </TextBlock>
                                <DockPanel Margin="0,14,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Paket sat" Command="{Binding SellPackageCommand}" Margin="0,0,8,0" />
                                        <Button Content="Ödeme al" Command="{Binding TakePaymentCommand}" />
                                    </StackPanel>
                                    <Border Background="{StaticResource NeutralSoftBrush}" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding BalanceText}" FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TabControl Margin="0,12,0,0">
                            <TabItem Header="Randevu geçmişi">
                                <DataGrid ItemsSource="{Binding History}" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding StartLocal, Converter={StaticResource DateFormat}}" Width="140" />
                                        <DataGridTextColumn Header="Hizmet" Binding="{Binding ServiceName}" Width="*" />
                                        <DataGridTextColumn Header="Seans" Binding="{Binding SessionLabel}" Width="90" />
                                        <DataGridTextColumn Header="Personel" Binding="{Binding StaffName}" Width="150" />
                                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusName}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Paketler">
                                <DataGrid ItemsSource="{Binding CustomerPackages}" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Paket" Binding="{Binding Label}" Width="*" />
                                        <DataGridTextColumn Header="Toplam" Binding="{Binding TotalSessions}" Width="80" />
                                        <DataGridTextColumn Header="Kullanılan" Binding="{Binding UsedSessions}" Width="90" />
                                        <DataGridTextColumn Header="Kalan" Binding="{Binding RemainingSessions}" Width="80" />
                                        <DataGridTextColumn Header="Geçerlilik" Binding="{Binding ExpiresAtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-date}" Width="110" />
                                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusName}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Hesap hareketleri" Visibility="{Binding CanSeePayments, Converter={StaticResource VisibleWhen}}">
                                <DataGrid ItemsSource="{Binding Transactions}" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding OccurredAtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" Width="140" />
                                        <DataGridTextColumn Header="İşlem" Binding="{Binding KindName}" Width="150" />
                                        <DataGridTextColumn Header="Tutar" Binding="{Binding AmountMinor, Converter={StaticResource Money}}" Width="120" />
                                        <DataGridTextColumn Header="Yöntem" Binding="{Binding MethodName}" Width="100" />
                                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Onam ve dosyalar">
                                <ContentControl Content="{Binding Records}" Focusable="False" />
                            </TabItem>
                            <TabItem Header="Kişisel veriler">
                                <StackPanel Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Subtle}" Text="KVKK kapsamındaki talepler için müşterinin tüm kayıtlarını dışa aktarabilir, kaydı arşivleyebilir veya kişisel verilerini kalıcı olarak anonimleştirebilirsiniz." />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Verileri dışa aktar (JSON)" Command="{Binding ExportCustomerCommand}" Margin="0,0,8,8" />
                                        <Button Content="Arşivle" Command="{Binding ArchiveCommand}" Margin="0,0,8,8" />
                                        <Button Content="Arşivden çıkar" Command="{Binding RestoreCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource DangerButton}" Content="Kişisel verileri sil (anonimleştir)" Command="{Binding AnonymizeCommand}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>

                    <TextBlock Text="Bir müşteri seçin veya yeni müşteri ekleyin." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Margin="0,80,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelection}" Value="False" />
                                            <Condition Binding="{Binding IsEditing}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
