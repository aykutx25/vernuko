<UserControl x:Class="Vernuko.Desktop.Views.CaptionButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The window's own buttons (custom title bar). Placed by MainWindow in line with the top bar's user menu. -->
    <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" ToolTip="Simge durumuna küçült" Click="OnMinimize" Width="40" AutomationProperties.Name="Simge durumuna küçült">
            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource Icon}" Width="12" Height="12" />
        </Button>
        <Button Style="{StaticResource IconButton}" ToolTip="Ekranı kapla / Önceki boyut" Click="OnMaximize" Width="40" AutomationProperties.Name="Ekranı kapla">
            <Path Data="{StaticResource IconMaximize}" Style="{StaticResource Icon}" Width="12" Height="12" />
        </Button>
        <Button Style="{StaticResource IconButton}" ToolTip="Kapat" Click="OnClose" Width="40" AutomationProperties.Name="Kapat">
            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="12" Height="12" />
        </Button>
    </StackPanel>
</UserControl>
