<UserControl x:Class="Vernuko.Desktop.Views.PrivateNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8,0,0">
        <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
        <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Bu notlar şifreli saklanır ve yalnızca siz görebilirsiniz; sekreter, diğer uzmanlar ve işletme sahibi göremez. Görüntüleme ve silme denetim kaydına yazılır (not içeriği yazılmaz)." />
        <TextBlock Text="{Binding OthersText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding OthersText, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="YENİ NOT" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" AutomationProperties.Name="Gizli not" />
        <Button Style="{StaticResource PrimaryButton}" Content="Notu kaydet" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,8,0,12" />
        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Sil" VerticalAlignment="Top"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <StackPanel>
                                <TextBlock Text="{Binding CreatedAtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
