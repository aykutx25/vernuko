<UserControl x:Class="Vernuko.Desktop.Views.WaitlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <CheckBox DockPanel.Dock="Right" Content="Kapananları da göster" IsChecked="{Binding IncludeClosed}" VerticalAlignment="Center" />
            <TextBlock Text="Bekleme Listesi" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Telefon" Binding="{Binding CustomerPhone}" Width="120" />
                        <DataGridTextColumn Header="Hizmet" Binding="{Binding ServiceName}" Width="130" />
                        <DataGridTextColumn Header="Personel" Binding="{Binding StaffName}" Width="110" />
                        <DataGridTextColumn Header="Tarih aralığı" Binding="{Binding RangeText}" Width="130" />
                        <DataGridTextColumn Header="Tercih" Binding="{Binding PreferredTime}" Width="100" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusName}" Width="90" />
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkButton}" Content="Randevu ver" Margin="0,0,10,0" Command="{Binding DataContext.BookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Arandı" Margin="0,0,10,0" Command="{Binding DataContext.MarkContactedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Randevulandı" Margin="0,0,10,0" Command="{Binding DataContext.MarkBookedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Çıkar" Command="{Binding DataContext.CancelEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Listeye ekle" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="MÜŞTERİ" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Ad veya telefon ile ara…" AutomationProperties.Name="Müşteri ara" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" Visibility="{Binding CustomerResults.Count, Converter={StaticResource VisibleWhen}}">
                            <ListBox ItemsSource="{Binding CustomerResults}" SelectedItem="{Binding Customer}" Style="{StaticResource PlainListBox}" MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Phone}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Text="HİZMET" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ServiceOptions}" SelectedItem="{Binding Service}" DisplayMemberPath="Label" />
                        <TextBlock Text="PERSONEL" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding Staff}" DisplayMemberPath="Label" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="EN ERKEN" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding From}" /></StackPanel>
                            <StackPanel><TextBlock Text="EN GEÇ" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding To}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="TERCİH EDİLEN ZAMAN" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PreferredTime, UpdateSourceTrigger=PropertyChanged}" Tag="ör. hafta içi öğleden sonra" />
                        <TextBlock Text="NOT" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Listeye ekle" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" Text="Bir randevu iptal edildiğinde, o saate uyan bekleyen müşteriler Randevular ekranında size gösterilir. Mesaj otomatik gönderilmez." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
