<UserControl x:Class="Vernuko.Desktop.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="620">
        <StackPanel MaxWidth="720">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="Program güncellemeleri" Style="{StaticResource SectionTitle}" />
            <TextBlock FontSize="15"><Run Text="Kurulu sürüm: " /><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding UnavailableReason, Converter={StaticResource VisibleWhen}}" />
            <StackPanel Visibility="{Binding CanCheck, Converter={StaticResource VisibleWhen}}" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Güncellemeleri denetle" Command="{Binding CheckCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Yedek al ve güncelle" Command="{Binding InstallCommand}" Visibility="{Binding UpdateAvailable, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="Güncelleme yalnızca siz onayladığınızda indirilir. Verileriniz programdan ayrı bir klasörde durur; güncelleme veya programı kaldırıp yeniden kurma verilerinizi silmez. Yeni sürüm veritabanını güncellemeden önce ayrıca bir güvenlik kopyası alır." />
        </StackPanel>
    </Border>
</UserControl>
