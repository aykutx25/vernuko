<UserControl x:Class="Vernuko.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="Raporlar" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <WrapPanel Margin="0,14,0,14">
                <DatePicker SelectedDate="{Binding From}" Width="160" Margin="0,0,8,6" />
                <DatePicker SelectedDate="{Binding To}" Width="160" Margin="0,0,8,6" />
                <Button Style="{StaticResource PrimaryButton}" Content="Göster" Command="{Binding LoadCommand}" Margin="0,0,16,6" />
                <Button Style="{StaticResource GhostButton}" Content="Bugün" Command="{Binding RangeCommand}" CommandParameter="today" Margin="0,0,4,6" />
                <Button Style="{StaticResource GhostButton}" Content="Bu hafta" Command="{Binding RangeCommand}" CommandParameter="week" Margin="0,0,4,6" />
                <Button Style="{StaticResource GhostButton}" Content="Bu ay" Command="{Binding RangeCommand}" CommandParameter="month" Margin="0,0,4,6" />
                <Button Style="{StaticResource GhostButton}" Content="Geçen ay" Command="{Binding RangeCommand}" CommandParameter="lastMonth" Margin="0,0,4,6" />
            </WrapPanel>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Report.TotalAppointments}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Toplam randevu" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Report.Completed}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Tamamlanan" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding CancellationText}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="İptal oranı" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding NoShowText}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Gelmeme oranı" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Report.PackagesSold}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Satılan paket" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Report.SessionsConsumed}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Kullanılan seans" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding CollectedText}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Tahsilat (net)" Style="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding OutstandingText}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Toplam açık bakiye" Style="{StaticResource Muted}" /></StackPanel></Border>
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,4,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Personel yoğunluğu (tamamlanan)" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ByStaff}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold" /><TextBlock Text="{Binding Name}" /></DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hizmet yoğunluğu (tamamlanan)" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ByService}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold" /><TextBlock Text="{Binding Name}" /></DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0" Visibility="{Binding ShowCommission, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel Margin="14,12,14,6">
                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"><Run Text="Toplam: " /><Run Text="{Binding CommissionTotalText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="Personel primleri" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Commission.Totals}" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Personel" Binding="{Binding StaffName}" Width="*" />
                            <DataGridTextColumn Header="Hizmet primi" Binding="{Binding ServiceMinor, Converter={StaticResource Money}}" Width="130" />
                            <DataGridTextColumn Header="Paket satış primi" Binding="{Binding PackageSaleMinor, Converter={StaticResource Money}}" Width="140" />
                            <DataGridTextColumn Header="Ürün satış primi" Binding="{Binding ProductSaleMinor, Converter={StaticResource Money}}" Width="140" />
                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalMinor, Converter={StaticResource Money}}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Muted}" Margin="14,8,14,12" TextWrapping="Wrap" Text="Primler işlem anında geçerli kurala göre hesaplanır ve sonradan değiştirilemez. Kurallar: Ayarlar › Prim kuralları." />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="Finansal tutarlar yalnızca finansal rapor yetkisi olan kullanıcılara gösterilir. CSV / Excel / PDF dışa aktarımı sonraki sürümde eklenecektir." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
