<UserControl x:Class="Vernuko.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding TodayText}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,18" />

            <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,16" Visibility="{Binding BackupWarning, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Yedekleme ayarları" Command="{Binding GoCommand}" CommandParameter="settings" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconWarning}" Style="{StaticResource Icon}" />
                        <TextBlock Text="{Binding BackupText}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="{Binding Today.Total}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Bugünkü randevu" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="{Binding Today.Open}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Bekleyen" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="{Binding Today.Completed}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Tamamlanan" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="{Binding Today.NoShow}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Gelmeyen" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Sıradaki randevular" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartLocal, Converter={StaticResource DateFormat}}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding ServiceName}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Yaklaşan randevu yok." Style="{StaticResource Muted}" Visibility="{Binding Upcoming.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hızlı başlangıç" Style="{StaticResource SectionTitle}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Yeni randevu (Ctrl+N)" Command="{Binding NewAppointmentCommand}" Margin="0,0,0,8" />
                        <Button Content="Randevu takvimi" Command="{Binding GoCommand}" CommandParameter="appointments" Margin="0,0,0,8" />
                        <Button Content="Müşteriler" Command="{Binding GoCommand}" CommandParameter="customers" Margin="0,0,0,8" />
                        <Button Content="Ayarlar" Command="{Binding GoCommand}" CommandParameter="settings" />
                        <TextBlock Text="{Binding BackupText}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
