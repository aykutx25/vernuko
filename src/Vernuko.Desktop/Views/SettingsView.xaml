<UserControl x:Class="Vernuko.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Vernuko.Desktop.Behaviors">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}" />
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <TabControl Grid.Row="2">
            <!-- Business -->
            <TabItem Header="İşletme" Visibility="{Binding CanManageSettings, Converter={StaticResource VisibleWhen}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="20" HorizontalAlignment="Left" MinWidth="720">
                        <StackPanel MaxWidth="760">
                            <TextBlock Style="{StaticResource Muted}"><Run Text="Faaliyet alanı: " /><Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="İŞLETME ADI" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="E-POSTA" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="ADRES" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="ÇALIŞMA SAATLERİ" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <ItemsControl ItemsSource="{Binding Hours}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsWorking}" />
                                            <TextBox Grid.Column="1" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" IsEnabled="{Binding IsWorking}" />
                                            <TextBox Grid.Column="2" Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWorking}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="RANDEVU ARALIĞI (dk)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding SlotMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><TextBlock Text="OTOMATİK KİLİT (dk, 0 = kapalı)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <CheckBox Content="Yeni randevular doğrudan 'Onaylandı' olarak açılsın" IsChecked="{Binding AutoConfirm}" Margin="0,12,0,0" />
                            <CheckBox Content="Gelmeyen müşterinin paket seansı düşülsün (varsayılan: hayır)" IsChecked="{Binding NoShowConsumesSession}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveBusinessCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" MinWidth="120" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Users -->
            <TabItem Header="Kullanıcılar" Visibility="{Binding CanManageUsers, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ad soyad" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="Kullanıcı adı" Binding="{Binding Username}" Width="140" />
                                <DataGridTextColumn Header="Rol" Binding="{Binding RoleName}" Width="130" />
                                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive, Mode=OneWay}" Width="60" />
                                <DataGridTemplateColumn Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource LinkButton}" Content="Aktif/pasif" Margin="0,0,12,0" Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource LinkButton}" Content="Parola sıfırla" Command="{Binding DataContext.ResetUserPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Yeni kullanıcı" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="AD SOYAD" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="KULLANICI ADI" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="GEÇİCİ PAROLA" Style="{StaticResource FieldLabel}" />
                            <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ROL" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewUserRole}" DisplayMemberPath="Label" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Sekreter randevu ve müşteri işlemlerini yapabilir; finansal raporları, kullanıcıları ve geri yüklemeyi göremez." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Kullanıcı ekle" Command="{Binding AddUserCommand}" Margin="0,14,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Backup -->
            <TabItem Header="Yedekleme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                        <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,12" Visibility="{Binding BackupStatus.KeyConfigured, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Yedeklemeyi etkinleştir" Command="{Binding EnableBackupCommand}" Visibility="{Binding CanManageBackups, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="Şifreli yedekleme henüz etkin değil. Etkinleştirdiğinizde size bir kurtarma anahtarı verilir." TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding ShownRecoveryKey, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="Yeni kurtarma anahtarınız" Style="{StaticResource SectionTitle}" />
                                <TextBox Text="{Binding ShownRecoveryKey, Mode=OneWay}" Style="{StaticResource MonoTextBox}" Height="50" HorizontalContentAlignment="Center" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Bu anahtarı kâğıda yazıp bilgisayardan ayrı saklayın. Bu ekrandan çıktıktan sonra tekrar gösterilmez." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Kopyala" Command="{Binding CopyRecoveryKeyCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Yazdım, doğrula" Command="{Binding ConfirmRecoveryKeyCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Yerel şifreli yedek" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" Text="Yedekler AES-256-GCM ile şifrelenir. Bu sürümde yedek, veritabanının tamamını içerir; fotoğraf/ek dosya desteği henüz yoktur. Yedekleme yalnızca Vernuko açıkken çalışır." />
                                <TextBlock Text="YEDEK KLASÖRÜ (harici disk / USB önerilir)" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Klasörü aç" Command="{Binding OpenBackupFolderCommand}" Margin="8,0,0,0" />
                                    <Button DockPanel.Dock="Right" Content="Gözat…" Command="{Binding BrowseBackupFolderCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="SIKLIK" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding Schedule}" DisplayMemberPath="Label" Width="150" /></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="GÜNLÜK SAKLA" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding RetainDaily, UpdateSourceTrigger=PropertyChanged}" Width="90" /></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="HAFTALIK SAKLA" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding RetainWeekly, UpdateSourceTrigger=PropertyChanged}" Width="90" /></StackPanel>
                                    <StackPanel><TextBlock Text="AYLIK SAKLA" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding RetainMonthly, UpdateSourceTrigger=PropertyChanged}" Width="90" /></StackPanel>
                                </WrapPanel>
                                <CheckBox Content="Uygulama kapanırken yedek al" IsChecked="{Binding BackupOnExit}" Margin="0,10,0,0" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Ayarları kaydet" Command="{Binding SaveBackupSettingsCommand}" Margin="0,0,8,8" Visibility="{Binding CanManageBackups, Converter={StaticResource VisibleWhen}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Şimdi yedekle" Command="{Binding BackupNowCommand}" Margin="0,0,8,8" />
                                    <Button Content="Kurtarma anahtarını doğrula" Command="{Binding ConfirmRecoveryKeyCommand}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource GhostButton}" Content="Yeni kurtarma anahtarı oluştur" Command="{Binding EnableBackupCommand}" Margin="0,0,8,8" Visibility="{Binding CanManageBackups, Converter={StaticResource VisibleWhen}}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Anahtar kimliği: " /><Run Text="{Binding BackupStatus.KeyId, Mode=OneWay}" />
                                    <Run Text="   ·   Son başarılı yedek: " /><Run Text="{Binding BackupStatus.LastSuccessUtc, Mode=OneWay, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Seçili yedeği doğrula" Command="{Binding VerifyBackupCommand}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource DangerButton}" Content="Seçili yedekten geri yükle" Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,0" Visibility="{Binding CanRestore, Converter={StaticResource VisibleWhen}}" />
                                            <Button Content="Dosyadan geri yükle…" Command="{Binding RestoreFromFileCommand}" Visibility="{Binding CanRestore, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <TextBlock Text="Yedekler" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding CreatedAtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" Width="150" />
                                        <DataGridTextColumn Header="Tür" Binding="{Binding Trigger}" Width="120" />
                                        <DataGridTextColumn Header="Boyut (bayt)" Binding="{Binding SizeBytes, StringFormat={}{0:N0}}" Width="130" />
                                        <DataGridCheckBoxColumn Header="Bu anahtarla" Binding="{Binding KeyMatches, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="*" />
                                        <DataGridTextColumn Header="Sorun" Binding="{Binding Problem}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Integrations & costs -->
            <TabItem Header="Entegrasyonlar ve Maliyetler">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Maliyet şeffaflığı" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Ücretli entegrasyonların hepsi varsayılan olarak kapalıdır ve otomatik harcama limiti 0 ₺'dir. Etkinleştirilen servisler işletmenin kendi hesabı üzerinden faturalandırılır; Vernuko mesaj veya bulut depolama ücreti almaz." />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Integrations}" Focusable="False" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                            <Border x:Name="Chip" Grid.Column="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource NeutralSoftBrush}">
                                                <TextBlock Text="{Binding Status}" FontSize="12.5" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Cost}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Commission rules -->
            <TabItem Header="Prim kuralları" Visibility="{Binding ShowCommissionRules, Converter={StaticResource VisibleWhen}}">
                <ContentControl Content="{Binding CommissionRules}" Focusable="False" />
            </TabItem>

            <!-- Consent templates -->
            <TabItem Header="Onam formları" Visibility="{Binding ShowConsentTemplates, Converter={StaticResource VisibleWhen}}">
                <ContentControl Content="{Binding ConsentTemplates}" Focusable="False" />
            </TabItem>

            <!-- License -->
            <TabItem Header="Lisans">
                <Border Style="{StaticResource Card}" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="620">
                    <StackPanel MaxWidth="720">
                        <TextBlock Text="Lisans durumu" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding LicenseText}" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Lisans süresi dolsa bile verileriniz silinmez veya kilitlenmez; Vernuko salt-okunur moda geçer ve yedek almanıza, dışa aktarmanıza izin verir." />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"><Run Text="Cihaz kimliği (gizlilik için özetlenmiş): " /><Run Text="{Binding DeviceId, Mode=OneWay}" FontFamily="Consolas" /></TextBlock>
                        <Button Content="Lisans dosyası yükle…" Command="{Binding ImportLicenseCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding CanManageLicense, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="Güncellemeler" Visibility="{Binding CanManageSettings, Converter={StaticResource VisibleWhen}}">
                <ContentControl Content="{Binding Updates}" Focusable="False" />
            </TabItem>

            <!-- Audit -->
            <TabItem Header="Denetim kaydı" Visibility="{Binding CanViewAudit, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="Bütünlüğü doğrula" Command="{Binding VerifyAuditCommand}" />
                        <TextBlock Text="{Binding AuditVerification}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding AuditEntries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60" />
                                <DataGridTextColumn Header="Zaman" Binding="{Binding OccurredAtUtc, Converter={StaticResource DateFormat}, ConverterParameter=utc-datetime}" Width="140" />
                                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding UserName}" Width="120" />
                                <DataGridTextColumn Header="İşlem" Binding="{Binding Action}" Width="180" />
                                <DataGridTextColumn Header="Ayrıntı" Binding="{Binding Summary}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- My account -->
            <TabItem Header="Hesabım">
                <Border Style="{StaticResource Card}" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top" Width="420">
                    <StackPanel>
                        <TextBlock Text="Parola değiştir" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="MEVCUT PAROLA" Style="{StaticResource FieldLabel}" />
                        <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="YENİ PAROLA" Style="{StaticResource FieldLabel}" />
                        <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Değiştir" Command="{Binding ChangeOwnPasswordCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
