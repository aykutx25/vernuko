<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Vernuko.Desktop</RootNamespace>
    <AssemblyName>Vernuko</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\vernuko.ico</ApplicationIcon>
    <!-- Velopack needs to run before WPF starts (see Program.cs). -->
    <StartupObject>Vernuko.Desktop.Program</StartupObject>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <!-- App/Window lifetimes are managed by WPF (disposed in OnExit), not IDisposable. -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vernuko.Presentation\Vernuko.Presentation.csproj" />
    <ProjectReference Include="..\Vernuko.Infrastructure\Vernuko.Infrastructure.csproj" />
    <ProjectReference Include="..\Vernuko.Remote\Vernuko.Remote.csproj" />
  </ItemGroup>
  <!-- Update feed (HTTPS) is set by the release pipeline: dotnet publish -p:VernukoUpdateUrl=https://… -->
  <ItemGroup Condition="'$(VernukoUpdateUrl)' != ''">
    <AssemblyMetadata Include="VernukoUpdateUrl" Value="$(VernukoUpdateUrl)" />
  </ItemGroup>
  <!-- License server (HTTPS) and trusted license public keys ("kid:base64-SPKI|kid2:…"), set by the release
       pipeline from repository variables. Public keys are not secret; the private key stays on the server. -->
  <ItemGroup Condition="'$(VernukoLicenseServerUrl)' != ''">
    <AssemblyMetadata Include="VernukoLicenseServerUrl" Value="$(VernukoLicenseServerUrl)" />
  </ItemGroup>
  <ItemGroup Condition="'$(VernukoLicenseKeys)' != ''">
    <AssemblyMetadata Include="VernukoLicenseKeys" Value="$(VernukoLicenseKeys)" />
  </ItemGroup>
  <!-- AGPL-3.0: the license and third-party notices ship with every build and installer. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\vernuko.ico" />
    <Resource Include="Assets\vernuko-256.png" />
  </ItemGroup>
</Project>
