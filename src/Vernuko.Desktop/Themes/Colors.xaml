<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vernuko design tokens: calm neutrals, navy/anthracite text, few controlled status colours. -->
    <Color x:Key="AppBackgroundColor">#F5F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F9FAFB</Color>
    <Color x:Key="BorderColor">#E3E6EB</Color>
    <Color x:Key="BorderStrongColor">#CDD2DA</Color>
    <Color x:Key="TextColor">#1B2640</Color>
    <Color x:Key="TextSecondaryColor">#5B6475</Color>
    <Color x:Key="TextMutedColor">#6B7385</Color>
    <Color x:Key="PrimaryColor">#1F2A44</Color>
    <Color x:Key="PrimaryHoverColor">#2C3A5C</Color>
    <Color x:Key="AccentColor">#3B6FD4</Color>
    <Color x:Key="SelectionColor">#E8EDF6</Color>
    <Color x:Key="HoverColor">#F1F3F7</Color>
    <Color x:Key="FocusColor">#6D8FD9</Color>

    <Color x:Key="SuccessColor">#1F7347</Color>
    <Color x:Key="SuccessSoftColor">#E8F5EE</Color>
    <Color x:Key="InfoColor">#2F64C8</Color>
    <Color x:Key="InfoSoftColor">#EAF0FC</Color>
    <Color x:Key="WarningColor">#8A5A0F</Color>
    <Color x:Key="WarningSoftColor">#FCF3E2</Color>
    <Color x:Key="DangerColor">#B03A3A</Color>
    <Color x:Key="DangerSoftColor">#FBEAEA</Color>
    <Color x:Key="NeutralSoftColor">#EEF0F4</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#661B2640" />

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppFontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#1B2640" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#1B2640" />
</ResourceDictionary>
