<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Vernuko.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1001;CA1063;CA1816;CA2000;CA5394;CA1822;CA1849;CA2234;xUnit1051;CA1508;CA2012</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vernuko.Presentation\Vernuko.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Vernuko.Infrastructure\Vernuko.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vernuko.LicenseServer\Vernuko.LicenseServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The license server tests start the real server on a loopback port. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
